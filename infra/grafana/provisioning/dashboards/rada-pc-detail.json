{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "uid": "rada-pc-detail",
  "title": "RADA — PC Detail",
  "tags": ["rada", "pc", "detail"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 3,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "pc_id",
        "label": "PC",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "rada_pg" },
        "query": "SELECT pc_id FROM pc_info ORDER BY pc_id",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "rada-pc-detail-panel",
      "title": "",
      "transparent": true,
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "rada_pg" },
      "gridPos": { "h": 30, "w": 24, "x": 0, "y": 0 },
      "options": { "demoMode": false, "demoPc": "PC-07" },
      "targets": [
        {
          "refId": "meta",
          "format": "table",
          "rawSql": "SELECT (scores->'panel')::text AS panel FROM anomaly_history WHERE pc_id = '$pc_id' ORDER BY detected_at DESC LIMIT 1"
        },
        {
          "refId": "ts",
          "format": "table",
          "rawSql": "SELECT collected_at AS time, cpu_percent AS cpu, mem_percent AS mem, gpu_percent AS gpu, (vram_mb/8192.0*100) AS vram, inbound_mb AS neti, outbound_mb AS neto, disk_write_mb AS disk FROM metrics_history WHERE pc_id = '$pc_id' AND $__timeFilter(collected_at) ORDER BY collected_at"
        }
      ]
    }
  ]
}
